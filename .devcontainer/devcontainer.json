{
  "name": "prime-rt-finder",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",

  // No container-engine-specific features here on purpose (e.g. no
  // docker-outside-of-docker) - that feature hardcodes a bind mount of
  // /var/run/docker.sock, which doesn't exist under Podman and makes the
  // whole container fail to start. See README.md, "Dev Container" ->
  // "Using Podman instead of Docker" for how to build/test the production
  // Dockerfile from inside the dev container with either engine, and for
  // Docker users who want that feature back, how to re-add it locally.

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "prime-rt-finder (npm start)",
      "onAutoForward": "notify"
    }
  },

  // CACHE_DIR deliberately points to a folder inside the mounted workspace
  // (not /app/data like in the Dockerfile) - it therefore persists
  // automatically on the host, without any extra Docker/Podman volume.
  "containerEnv": {
    "PORT": "3000",
    "CACHE_DIR": "${containerWorkspaceFolder}/.dev-data"
  },

  // TMDB_API_KEY/OMDB_API_KEY are NOT stored in this repo, but passed
  // through from the host environment. Set them before opening in the dev
  // container, e.g. in ~/.bashrc/~/.zshrc:
  //   export TMDB_API_KEY=your_key
  //   export OMDB_API_KEY=your_key
  // See README.md, "Dev Container" section.
  "remoteEnv": {
    "TMDB_API_KEY": "${localEnv:TMDB_API_KEY}",
    "OMDB_API_KEY": "${localEnv:OMDB_API_KEY}"
  },

  "postCreateCommand": "npm install && npx playwright install --with-deps chromium webkit",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },

  // "node" matches the built-in non-root user of the base image, which
  // also happens to be what rootless Podman needs (a non-root container
  // user) - see README for the additional Podman-specific runArgs some
  // setups still need on top of this.
  "remoteUser": "node"
}
